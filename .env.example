ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
DUCKDB_PATH=data/db/argos.duckdb
DATA_START_DATE=2022-01-01
DATA_END_DATE=2024-12-31
RANDOM_SEED=42
# docker compose --profile setup run --rm setup 이 생성할 기간. 위 DATA_* 와 별개다
# (compose 는 이 .env 로 변수를 치환하므로, DATA_* 를 쓰면 setup 이 3년치를 만든다).
# 비워 두면 2024-06-01 ~ 2024-06-30
SETUP_START_DATE=
SETUP_END_DATE=
LOG_LEVEL=INFO
