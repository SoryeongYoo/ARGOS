{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_fix.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }, 
  "permissions": {
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push*-f*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push*-f*)"
    ],
    "ask": [
      "Bash(git push*main*)",
      "PowerShell(git push*main*)"
    ]
  }
}
